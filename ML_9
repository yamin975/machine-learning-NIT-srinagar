Number of function evaluations (SciPy tested your function 11 times to find the slope).\n","# x: 6.0                         -> The exact point where the derivative was evaluated.\n"],"metadata":{"id":"VGKs_vWgFDOa","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1790086407403,"user_tz":-330,"elapsed":81,"user":{"displayName":"YAMIN","userId":"01944431232169792445"}},"outputId":"38a345cf-e462-483c-a690-e8552b37997a"},"execution_count":30,"outputs":[{"output_type":"stream","name":"stdout","text":["     success: True\n","      status: 0\n","          df: 11.999999999999886\n","       error: 5.684341886080802e-14\n","         nit: 2\n","        nfev: 11\n","           x: 6.0\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"yIm2VjfhFDS9"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"PAu4AE0WFDXc"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"UsNlX71dFDbU"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from scipy.fft import fft, fftfreq  # or use np.fft.fft, np.fft.fftfreq\n","\n","# 1. Setup time array (1 second duration at 1000 Hz sampling rate)\n","fs = 1000\n","t = np.linspace(0, 1, fs, endpoint=False)\n","\n","# 2. Mix 3 frequencies with EQUAL amplitudes (e.g., all 1.0)\n","# This will generate 3 positive peaks and 3 negative mirror peaks = 6 peaks total.\n","y1 = 1.0*np.sin(2*np.pi*10*t) + 1.0*np.sin(2*np.pi*30*t) + 1.0*np.sin(2*np.pi*50*t)\n","\n","# 3. Compute the FFT and get the magnitude\n","sig_x = fft(y1)\n","mag_sig = abs(sig_x) / len(y1)  # Normalized by length so peak heights match the amplitude (0.5 each)\n","\n","# 4. Generate the frequency axis labels\n","sig_freq = fftfreq(len(y1), 1/fs)\n","\n","# 5. Plot the full spectrum\n","plt.figure(figsize=(10, 4))\n","plt.plot(sig_freq, mag_sig, color='tab:blue')\n","plt.title(\"FFT Spectrum with 6 Equal Height Peaks\")\n","plt.xlabel(\"Frequency (Hz)\")\n","plt.ylabel(\"Magnitude\")\n","plt.grid(True, linestyle='--', alpha=0.6)\n","\n","# Zoom in on the region containing your signals (-100 to 100 Hz shows them perfectly)\n","plt.xlim(-80, 80)\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":410},"id":"YOEC5vl05FB4","executionInfo":{"status":"ok","timestamp":1789643467778,"user_tz":-330,"elapsed":1093,"user":{"displayName":"YAMIN","userId":"01944431232169792445"}},"outputId":"41f8461f-2a95-4a00-de2d-268c3c600f10"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":[],"metadata":{"id":"Bzf2L5L15FE4"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"oNd5AOMS5FHl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"jk9i6gAa5FKk"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"pnCFhNm25FNV"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"rfcydlS95FQ5"},"execution_count":null,"outputs":[]}]}